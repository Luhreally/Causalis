{
  "name": "causalis-living-equation",
  "version": "0.9.0",
  "private": true,
  "description": "A deterministic artificial-life god game and emergent-history simulator.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node smoke-test.cjs",
    "test:cohort": "node tests/cohort-smoke.cjs",
    "test:mobile": "node tests/mobile-smoke.cjs",
    "test:conflict": "node scripts/run-smoke-mode.cjs CONFLICT_DEBUG",
    "test:systems": "node scripts/run-smoke-mode.cjs SYSTEMS_DEBUG",
    "test:save": "node scripts/run-smoke-mode.cjs SAVE_DEBUG",
    "test:clock": "node scripts/run-smoke-mode.cjs CLOCK_DEBUG",
    "test:visual": "node scripts/run-smoke-mode.cjs QUICK_VISUAL",
    "test:syntax": "node scripts/check-runtime.cjs",
    "test:experience": "node tests/experience-smoke.cjs",
    "test:living": "node tests/living-world-smoke.cjs",
    "test:legends": "node tests/legends-smoke.cjs",
    "test:languages": "node tests/languages-smoke.cjs",
    "test:observatory": "node tests/observatory-smoke.cjs",
    "test:belief": "node tests/belief-smoke.cjs",
    "test:character": "node tests/character-smoke.cjs",
    "test:society": "node tests/society-smoke.cjs",
    "test:bonds": "node tests/bonds-smoke.cjs",
    "test:divine": "node tests/divine-smoke.cjs",
    "test:years": "node tests/years-smoke.cjs",
    "test:diplomacy": "node tests/diplomacy-smoke.cjs",
    "test:fast": "npm run test:syntax && npm run test:cohort && npm run test:mobile && npm run test:conflict && npm run test:systems && npm run test:save && npm run test:living && npm run test:legends && npm run test:languages && npm run test:observatory && npm run test:belief && npm run test:character && npm run test:society && npm run test:bonds && npm run test:divine && npm run test:years && npm run test:diplomacy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "vite": "^7.0.0"
  }
}
