{
  "name": "causalis-universe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Causalis Universe: a deterministic, observatory-first, multi-scale causal universe.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p .",
    "lint": "node tools/lint.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "golden": "node tools/golden.ts",
    "engines": "node tools/engines.ts",
    "oracle": "node tools/oracle.ts",
    "app-check": "node tools/app-check.ts",
    "slice": "node tools/slice.ts",
    "gate:2": "node tools/phase2-gate.ts 500",
    "calibrate": "node tools/calibration.ts 900",
    "gate:3": "node tools/phase3-gate.ts 900",
    "gate:4": "node tools/phase4-gate.ts",
    "gate:5": "node tools/phase5-gate.ts",
    "gate:6": "node tools/phase6-gate.ts",
    "gate:7": "node tools/phase7-gate.ts",
    "gate:8": "node tools/phase8-gate.ts",
    "gate:9": "node tools/phase9-gate.ts",
    "gate:10": "node tools/phase10-gate.ts",
    "gate:11": "node tools/phase11-gate.ts",
    "gate:12": "node tools/phase12-gate.ts",
    "gate:13": "node tools/phase13-gate.ts",
    "gate:14": "node tools/phase14-gate.ts",
    "gate:15": "node tools/phase15-gate.ts",
    "diversity": "node tools/diversity.ts 100 900"
  },
  "dependencies": {
    "playcanvas": "^2.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "oxc-parser": "^0.151.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
