    "golden": "node tools/golden.ts",
    "engines": "node tools/engines.ts"
  },
  "dependencies": {
    "playcanvas": "^2.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "oxc-parser": "^0.151.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
